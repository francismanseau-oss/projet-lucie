# Copier vers .dev.vars (jamais committer .dev.vars)
# Clés TEST Stripe uniquement (sk_test_…) — Lucie les colle elle-même.
# Avec Stripe CLI : stripe listen → coller le whsec_ affiché ici, puis relancer wrangler.
# Ces valeurs d'exemple sont INVALIDES volontairement. JAMAIS sk_live ici.

STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_CLE_TEST_LUCIE
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER_PAR_SIGNING_SECRET_TEST

